{
  "name": "flavorforked",
  "version": "0.1.0",
  "description": "AI cooking app - turn pantry or photos into recipes",
  "type": "module",
  "scripts": {
    "dev": "tanstack-start dev",
    "build": "tanstack-start build",
    "start": "node dist/index.js",
    "preview": "node dist/index.js",
    "seed": "node --loader ts-node/esm scripts/seed.ts",
    "create-indexes": "node --loader ts-node/esm scripts/create-indexes.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tanstack/react-router": "^1.51.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-form": "^0.37.0",
    "@tanstack/start": "^1.33.0",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8",
    "mongodb": "^6.8.0",
    "better-auth": "^1.5.0",
    "@google/generative-ai": "^0.16.0",
    "tailwindcss": "^4.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.471.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.4",
    "vitest": "^2.1.2",
    "ts-node": "^10.9.2",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "@playwright/test": "^1.48.0"
  }
}
